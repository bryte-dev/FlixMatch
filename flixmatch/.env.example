# Copy to .env (never commit .env)
DATABASE_PUBLIC_URL=postgresql://postgres:postgres@localhost:5432/flixmatch
TMDB_API_KEY=your_tmdb_v4_read_access_token
JWT_SECRET=change-me-long-random-string
NODE_ENV=development
# Optional, only for a separate frontend dev server:
# CORS_ORIGIN=http://localhost:5173
# VITE_API_URL=http://localhost:3000
# Optional: IMDb ratings through OMDb (https://www.omdbapi.com/apikey.aspx). Without it, IMDb badges are hidden.
OMDB_API_KEY=
# Optional: PostHog product analytics (public project key "phc_...", read at BUILD time by Vite).
# Leave empty to disable analytics entirely. NEXT_PUBLIC_POSTHOG_KEY / _HOST are accepted too.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
